{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ikaze Ledger",
  "version": "1.0.10",
  "identifier": "com.mud.debtagent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ikaze Ledger — Debt Management System",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "shadow": true,
        "windowEffects": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob: asset:; connect-src 'self' blob: asset: https://github.com https://api.github.com"
    },
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Ikaze Ledger — Debt Management System",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 MUD — Marcel UWIMANA. All rights reserved.",
    "category": "Finance",
    "shortDescription": "Offline-first debt & customer management for small businesses",
    "longDescription": "Ikaze Ledger is an offline-first debt and customer management application for small and medium businesses. Track customer debts, payments, inventory, and generate professional reports, receipts, and proforma invoices. Works fully offline. Powered by MUD.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com",
      "webviewInstallMode": {"type": "downloadBootstrapper"}
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Impano-Hub-Rwanda/IKAZE-LEDGER-VER-1.0.0/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2RDBGNkFEQzA4QjRCQjkKUldTNVM0dkFyZmJRMXVkRkcwV0pBQk1WeThBajg1VUI3VGk5bGU0OHlXeU9xSTVHYzFMcFUzUmsK",
      "windows": {"installMode": "passive"}
    }
  }
}
